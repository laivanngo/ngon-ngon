# =============================================================================
# Ngon-Ngon Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values:
#   cp .env.example .env
#
# SECURITY: .env chứa secrets → KHÔNG BAO GIỜ commit lên git
# =============================================================================

# --- Database ---
DB_NAME=ngonngon
DB_USER=ngonngon
DB_PASSWORD=CHANGE_ME_to_a_strong_random_password

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_to_a_random_string_at_least_32_chars

# --- CORS ---
# Domain thực tế của bạn, cách nhau bằng dấu phẩy
# WHY không dùng *: chặn request từ domain lạ, tránh CSRF
ALLOWED_ORIGINS=https://ngonngon.vn,https://www.ngonngon.vn

# --- Environment ---
# development | staging | production
# development: debug mode, auto-reload, SQLite fallback
# production: no debug, strict CORS, optimized
ENV=production

# --- Ports (chỉ dùng cho docker-compose) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Admin mặc định (chỉ dùng lần đầu seed) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Zalo OA (optional — bật khi có Official Account) ---
# ZALO_OA_ACCESS_TOKEN=
# ZALO_OA_PHONE=0378148148

# --- KDS (Kitchen Display System) ---
# PIN 4 số cho bếp — nhập trên kds.html để xem đơn hàng
# Đổi PIN: sửa dưới đây rồi `make restart`
KDS_PIN=1234

# --- Multi-tenant (v3: SaaS foundation) ---
# ID của quán hiện tại. Mọi data mặc định gắn với store này.
# Khi thêm quán mới, resolve store_id từ subdomain/header.
DEFAULT_STORE_ID=1

# --- Uvicorn ---
# WHY 1 worker (default): WebSocket notification cần broadcast trong cùng process.
# 2+ workers → WS connection ở worker A, order tạo ở worker B → admin không nhận notification.
# FastAPI async xử lý hàng trăm concurrent requests với 1 worker → đủ cho quán nhỏ-vừa.
# Chỉ tăng workers nếu: (a) CPU usage > 80% VÀ (b) chấp nhận WS notification không realtime
UVICORN_WORKERS=1

# --- Backup Alerting (optional — Telegram notification khi backup fail) ---
# Tạo bot: https://t.me/BotFather → /newbot → lấy token
# Lấy chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
# TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TG_CHAT_ID=-100123456789
